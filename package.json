{
  "name": "dokke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "portless": {
    "name": "dokke",
    "script": "start"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "mac:install": "cd mac && ./install.sh",
    "mac:open": "cd mac && ./install.sh --open",
    "windows:build-icon-addon": "cd platform/windows/native/icon-addon && pnpm dlx node-gyp clean && pnpm dlx node-gyp configure build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "playwright": "^1.62.1"
  },
  "optionalDependencies": {
    "ds-store": "^0.1.6"
  }
}
